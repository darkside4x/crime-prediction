{
  "schema_version": "1.0.0",
  "experiment_name": "datasf-2024h1-aggregate-count-benchmark",
  "target": "event_count",
  "window_hours": 6,
  "train_fraction": 0.6,
  "validation_fraction": 0.2,
  "min_intervals_per_split": 30,
  "poisson_l2": 1.0,
  "poisson_max_iterations": 100,
  "poisson_tolerance": 1e-7,
  "selection_min_relative_gain": 0.01,
  "primary_metric": "poisson_deviance",
  "top_k_fraction": 0.1,
  "calibration_bins": 10,
  "min_training_events_to_publish": 3,
  "risk_band_thresholds": [0.2, 0.5, 0.75],
  "enable_lightgbm": false,
  "random_seed": 20260829,
  "rolling_origins": 3,
  "bootstrap_samples": 100,
  "explicit_train_end": null,
  "explicit_validation_end": null,
  "features": [
    "lag_1", "lag_2", "lag_7", "lag_14", "rolling_7_mean",
    "rolling_14_mean", "neighbor_lag_1", "recent_trend", "hour_sin",
    "hour_cos", "day_of_week_sin", "day_of_week_cos", "coverage_ratio"
  ]
}
