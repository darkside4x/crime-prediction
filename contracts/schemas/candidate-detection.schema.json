{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crime-hotspot.local/schemas/candidate-detection.schema.json",
  "title": "RestrictedCandidateDetection",
  "description": "A machine-generated candidate safety incident requiring human review. It is not a confirmed crime or forecast.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "detection_id", "source_id", "occurred_at", "received_at", "proposed_category", "confidence", "detector_version", "evidence_ref", "review_status", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "detection_id": {"type": "string", "format": "uuid"},
    "source_id": {"type": "string", "format": "uuid"},
    "asset_id": {"type": "string", "format": "uuid"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "proposed_category": {"enum": ["property", "violence", "public_order", "traffic_safety", "other", "unmapped"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "detector_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "evidence_ref": {"type": "string", "pattern": "^secret://", "maxLength": 512},
    "review_status": {"enum": ["awaiting_review", "confirmed", "rejected", "expired"]},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
