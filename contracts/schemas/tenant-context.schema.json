{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crime-hotspot.local/schemas/tenant-context.schema.json",
  "title": "ServerTenantContext",
  "description": "Internal request context derived from authenticated server-side claims. Browser input must never construct this object.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "principal_id", "tenant_id", "role", "authenticated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "principal_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "tenant_id": {"type": "string", "format": "uuid"},
    "role": {"enum": ["viewer", "reviewer", "tenant_admin", "platform_operator"]},
    "authenticated_at": {"type": "string", "format": "date-time"}
  }
}
