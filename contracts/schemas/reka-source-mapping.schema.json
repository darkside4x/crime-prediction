{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crime-hotspot.local/schemas/reka-source-mapping.schema.json",
  "title": "RekaSourceMappingProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "source_id", "mappings", "unmapped_source_fields", "warnings", "requires_human_approval", "reka_model", "prompt_version"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "source_id": {"type": "string", "format": "uuid"},
    "mappings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_field", "target_field", "confidence", "transformation"],
        "properties": {
          "source_field": {"type": "string", "minLength": 1, "maxLength": 128},
          "target_field": {"enum": ["external_event_id", "occurred_at", "category", "location.latitude", "location.longitude", "ignore", "unmapped"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "transformation": {"type": "string", "maxLength": 500}
        }
      }
    },
    "unmapped_source_fields": {"type": "array", "items": {"type": "string", "maxLength": 128}, "maxItems": 100, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 20},
    "requires_human_approval": {"const": true},
    "reka_model": {"type": "string", "minLength": 1, "maxLength": 100},
    "prompt_version": {"type": "string", "minLength": 1, "maxLength": 50}
  }
}
