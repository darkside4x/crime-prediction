{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crime-hotspot.local/schemas/model-card.schema.json",
  "title": "AggregateForecastModelCard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "model_version", "data_version", "generated_at", "model_name", "target", "prediction_unit", "training_period", "evaluation_period", "primary_metric", "baseline_comparison", "intended_uses", "prohibited_uses", "limitations", "uncertainty_method", "suppression_policy", "feature_interpretation", "human_review_required"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "data_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "generated_at": {"type": "string", "format": "date-time"},
    "model_name": {"enum": ["historical_rate", "previous_period", "regularized_poisson", "lightgbm_poisson", "lightgbm_tweedie"]},
    "target": {"enum": ["next_window_count", "next_window_occurrence"]},
    "prediction_unit": {"type": "string", "minLength": 1, "maxLength": 300},
    "training_period": {"$ref": "#/$defs/period"},
    "evaluation_period": {"$ref": "#/$defs/period"},
    "primary_metric": {"$ref": "#/$defs/cardMetric"},
    "baseline_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_model", "baseline_value", "selected_value", "relative_gain", "selected_model_beats_baseline"],
      "properties": {
        "baseline_model": {"enum": ["historical_rate", "previous_period"]},
        "baseline_value": {"type": "number"},
        "selected_value": {"type": "number"},
        "relative_gain": {"type": "number"},
        "selected_model_beats_baseline": {"type": "boolean"}
      }
    },
    "intended_uses": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "prohibited_uses": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "uncertainty_method": {"type": "string", "minLength": 1, "maxLength": 1000},
    "suppression_policy": {"type": "string", "minLength": 1, "maxLength": 1000},
    "feature_interpretation": {"type": "string", "minLength": 1, "maxLength": 1000},
    "human_review_required": {"const": true}
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "cardMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "split", "definition"],
      "properties": {
        "name": {"enum": ["poisson_deviance", "mae", "pr_auc", "brier_score"]},
        "value": {"type": "number"},
        "split": {"const": "test"},
        "definition": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
